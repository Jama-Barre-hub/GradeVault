# GradeVault — environment template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed.
# This file (.env.example) IS committed, so it must contain no real secrets.

# Generate a key with:
#     python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-generated-key

# Never True in production.
DJANGO_DEBUG=True

# Comma-separated. In production, list your real domain(s).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional. Unset locally to use SQLite; set in production for PostgreSQL.
# DATABASE_URL=postgres://user:password@host:5432/gradevault

# Public demo only. Turns the whole deployment read-only: every request
# that would change data is refused, for every account including the
# administrator, and the sign-in details below are shown on the public
# page. Leave this off for a real school — a school that cannot record
# marks is not running a results system.
# DEMO_MODE=True
# DEMO_PASSWORD=demo-password
